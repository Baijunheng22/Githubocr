{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voiceledger-ocr",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "VOLC_ACCESS_KEY_ID",
      "VOLC_SECRET_ACCESS_KEY"
    ]
  }
}
